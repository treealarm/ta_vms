<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Annotations without warnings: the ported Square code was compiled with annotations, and
         its nullable flow analysis is not clean enough for `enable` yet. New code still uses the
         annotations, so the intent is visible. -->
    <Nullable>annotations</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapr.AspNetCore" Version="1.18.7" />
    <PackageReference Include="Dapr.Client" Version="1.18.7" />
    <PackageReference Include="Dapr.Messaging" Version="1.18.7" />
    <PackageReference Include="Google.Protobuf" Version="3.35.1" />
    <PackageReference Include="Grpc.AspNetCore" Version="2.83.0" />
    <PackageReference Include="Grpc.Tools" Version="2.83.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL.NetTopologySuite" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VmsDb\VmsDb.csproj" />
    <ProjectReference Include="..\VmsLog\VmsLog.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="..\..\proto\vms_map.proto" GrpcServices="Both" />
    <!-- The camera core: a placement is checked against GetCamera, see ICameraCatalog. -->
    <Protobuf Include="..\..\proto\vms_cfg.proto" GrpcServices="Client" />
    <!-- The node's retention journal and source liveness, read by the alarm and connectivity
         adapters. -->
    <Protobuf Include="..\..\proto\vms_fs.proto" GrpcServices="Client" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Grpc/migrations/*.sql" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- The demo world's pictures: plan images and diagram type backgrounds, in the assembly so
         an install does not depend on a file on the instance's disk. -->
    <EmbeddedResource Include="Demo/Assets/**" />
  </ItemGroup>

</Project>
