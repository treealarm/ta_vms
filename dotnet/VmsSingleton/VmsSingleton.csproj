<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapr.AspNetCore" Version="1.18.7" />
    <PackageReference Include="Dapr.Client" Version="1.18.7" />
    <PackageReference Include="Dapr.Messaging" Version="1.18.7" />
    <PackageReference Include="Google.Protobuf" Version="3.35.1" />
    <PackageReference Include="Grpc.AspNetCore" Version="2.83.0" />
    <PackageReference Include="Grpc.Tools" Version="2.83.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VmsLog\VmsLog.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="..\..\proto\vms_singleton.proto" GrpcServices="Both" />
    <Protobuf Include="..\..\proto\vms_cfg.proto" GrpcServices="Client" />
    <!-- The event router reads the journal and runs its actions: an event, a node's arming, the
         journal write and the alarm raise all live in VmsMap. -->
    <Protobuf Include="..\..\proto\vms_map.proto" GrpcServices="Client" />
    <!-- The actions that reach a node's own services: retention on its VmsFs and a relay on its
         VmsOnvif. Which of them is addressed comes from VmsCfg's node registry. -->
    <Protobuf Include="..\..\proto\vms_fs.proto" GrpcServices="Client" />
    <Protobuf Include="..\..\proto\onvif.proto" GrpcServices="Client" />
  </ItemGroup>

</Project>
