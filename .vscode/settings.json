{
    // F5 must not start the stack when "prepare: stack" failed. The default is a prompt with a
    // "Debug Anyway" button, and taking it launches every service with no Dapr sidecar behind
    // it -- which fails silently: the apps run, every gRPC call between them dies on "Error
    // connecting to subchannel", and the only visible symptom is empty lists in the UI.
    //
    // "showErrors" rather than "abort": both refuse to launch and neither offers "Debug Anyway",
    // but "abort" cancels without saying anything at all. Pressing F5 and having nothing whatever
    // happen is indistinguishable from a broken keybinding, and the gate tasks' own message --
    // which names the missing service and the command that starts it -- was being thrown away.
    "debug.onTaskErrors": "showErrors",
    "workbench.colorTheme": "Light 2026",
    // The workspace root holds no solution, so without this C# Dev Kit builds one of its own from
    // every .csproj it finds and caches it: projects that were moved or deleted (OnvifLib's
    // samples, KeycloakAdmin) then keep failing restore and leave obj/ folders behind where they
    // used to be.
    "dotnet.defaultSolution": "dotnet/ta_vms.sln",
    "cmake.sourceDirectory": "${workspaceFolder}/video_srv",
    "cmake.configurePreset": "linux-default",
    "cmake.buildDirectory": "${workspaceFolder}/video_srv/build"
}
