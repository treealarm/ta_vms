    "compounds": [
        {
            "name": "Full stack (F5)",
            "stopAll": true,
            // Builds everything once and brings up every sidecar in one terminal, before any
            // configuration starts. Two reasons. Ordering: without a single build up front the
            // C++ build finishes in about a second while ten .NET launches queue behind one
            // dotnet:build, and the vms sidecar ends up starting some 30 seconds ahead of vmscfg
            // — a gap that has been observed to leave it unable to resolve app id vmscfg at all,
            // so video_srv never gets its camera list and no stream is ever published.
            // Teardown: VS Code does not stop tasks when a debug session ends, so a per-service
            // sidecar task means one surviving terminal per service to close by hand after Stop
            // (stopAll governs debug sessions only). One task leaves one terminal.
            "preLaunchTask": "prepare: stack",
            "configurations": [
                "VmsCfg (.NET)",
                "VmsUtils (.NET)",
                "VmsOnvif (.NET)",
                "VmsOnvifActors (.NET)",
                "VmsFs (.NET)",
                "VmsAnalyticsSingleton (.NET)",
