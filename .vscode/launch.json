        {
            "name": "ROI Transcode (C++)",
            "type": "cppdbg",
            "request": "launch",
            "preLaunchTask": "build:all",
            "postDebugTask": "dapr:roitrc:stop",
            "program": "${workspaceFolder}/roitrc/build/roitrc",
            "args": [],
            "environment": [
                { "name": "APP_ID", "value": "roitrc" },
                { "name": "GRPC_ROI_BIND", "value": "127.0.0.1" },
                { "name": "GRPC_ROI_PORT", "value": "5142" },
                // Under F5 the archive is not in /data as it is in compose: it sits
                // beside the checkout, at the same paths VMS_STORAGE_BASE_PATH and
                // VMS_EXPORT_BASE_PATH give the other services.
                { "name": "ROI_ALLOWED_ROOTS", "value": "${workspaceFolder}/../media_storage:${workspaceFolder}/../exports:/tmp" },
                // This service's own sidecar, per dotnet/dapr.yaml.
                { "name": "DAPR_GRPC_PORT", "value": "51009" },
                { "name": "PUBSUB_NAME", "value": "orderpubsub" },
                // The system's Intel driver, as for video_srv below. Without it the
                // encoder falls back to the CPU and still works.
                { "name": "LIBVA_DRIVER_NAME", "value": "iHD" },
                { "name": "LIBVA_DRIVERS_PATH", "value": "/usr/lib/x86_64-linux-gnu/dri" }
            ],
            "cwd": "${workspaceFolder}/roitrc",
            "stopAtEntry": false,
            "MIMode": "gdb",
            "externalConsole": false,
            // All three, as for the media server: "enabled off" alone is not
            // enough, and gdb then hangs fetching debug info over the network
            // with the program never continued past its first trap.
            "setupCommands": [
                { "text": "-enable-pretty-printing" },
                { "text": "set debuginfod enabled off", "ignoreFailures": true },
                { "text": "set debuginfod urls \"\"", "ignoreFailures": true },
                { "text": "set debuginfod verbose 0", "ignoreFailures": true }
            ]
        },
        {
            "name": "Media Server (C++)",
            "type": "cppdbg",
            "request": "launch",
            "preLaunchTask": "build:all",
            "postDebugTask": "dapr:vms:stop",
            "program": "${workspaceFolder}/video_srv/build/vms",
            "args": [],
            "environment": [
                {
                    "name": "DEBUGINFOD_URLS",
                    "value": ""
                },
                // Where the VA-API driver is. The binary finds vcpkg's libva through its RPATH,
                // but libva itself then searches vcpkg's build prefix -- a directory that only
                // exists on the machine that built the package. Without this, va_openDriver()
                // returns -1, the encoder chain drops to the CPU path, and the only sign is a
                // "Failed to initialise VAAPI connection" line on stderr that never reaches the
                // JSON log. The distribution's own driver is what the container uses too.
                {
                    "name": "LIBVA_DRIVER_NAME",
                    "value": "iHD"
                },
                {
                    "name": "LIBVA_DRIVERS_PATH",
                    "value": "/usr/lib/x86_64-linux-gnu/dri"
