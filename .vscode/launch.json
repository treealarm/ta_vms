{
    "version": "0.2.0",
    "configurations": [
    
        {
            "name": "Backend (.NET)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "prepare:web_vms",
            "postDebugTask": "dapr:web_vms:stop",
            "program": "${workspaceFolder}/web_vms/web_vms.Server/bin/Debug/net8.0/web_vms.Server.dll",
            "cwd": "${workspaceFolder}/web_vms/web_vms.Server",
            "stopAtEntry": false,
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "WEB_VMS_PORT": "5134",
                "DAPR_HTTP_PORT": "3500",
                "DAPR_GRPC_PORT": "50001",
                "DAPR_LOGGER_APP_ID": "vmslogger",
                "DAPR_CFG_APP_ID": "vmscfg",
                "DAPR_FS_APP_ID": "vmsfs",
                "DAPR_ONVIF_APP_ID": "vmsonvif"
            }
        },
        {
            "name": "VmsCfg (.NET)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "prepare:vmscfg",
            "postDebugTask": "dapr:vmscfg:stop",
            "program": "${workspaceFolder}/web_vms/VmsCfg/bin/Debug/net8.0/VmsCfg.dll",
            "cwd": "${workspaceFolder}/web_vms/VmsCfg",
            "stopAtEntry": false,
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "CFG_VMS_PORT": "5135",
                "DAPR_HTTP_PORT": "3501",
                "DAPR_GRPC_PORT": "50002",
                "PUBSUB_NAME": "pubsub",
                "POSTGRES_HOST": "localhost",
                "POSTGRES_PORT": "5433",
                "POSTGRES_USER": "postgres",
                "POSTGRES_PASSWORD": "postgres",
                "POSTGRES_CFG_DB": "ta_cfg",
                "VMS_WEBRTC_RTSP_BASE_URL": "rtsp://localhost:8554",
                "VMS_WEBRTC_CLIENT_URL": "http://localhost:8889"
            }
        },
        {
            "name": "VmsOnvif (.NET)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "prepare:vmsonvif",
            "postDebugTask": "dapr:vmsonvif:stop",
            "program": "${workspaceFolder}/web_vms/VmsOnvif/bin/Debug/net8.0/VmsOnvif.dll",
            "cwd": "${workspaceFolder}/web_vms/VmsOnvif",
            "stopAtEntry": false,
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "ONVIF_SRV_PORT": "5136",
                "DAPR_HTTP_PORT": "3502",
                "DAPR_GRPC_PORT": "50003",
                "DAPR_CFG_APP_ID": "vmscfg"
            }
        },
        {
            "name": "VmsOnvifActors (.NET)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "prepare:vmsonvif-actors",
            "postDebugTask": "dapr:vmsonvif-actors:stop",
            "program": "${workspaceFolder}/web_vms/VmsOnvifActors/bin/Debug/net8.0/VmsOnvifActors.dll",
            "cwd": "${workspaceFolder}/web_vms/VmsOnvifActors",
            "stopAtEntry": false,
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "ONVIF_ACTORS_PORT": "5141",
                "DAPR_HTTP_PORT": "3505",
                "DAPR_GRPC_PORT": "50007"
            }
        },
        {
            "name": "VmsFs (.NET)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "prepare:vmsfs",
            "postDebugTask": "dapr:vmsfs:stop",
            "program": "${workspaceFolder}/web_vms/VmsFs/bin/Debug/net8.0/VmsFs.dll",
            "cwd": "${workspaceFolder}/web_vms/VmsFs",
            "stopAtEntry": false,
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "FS_VMS_PORT": "5137",
                "DAPR_HTTP_PORT": "3504",
                "DAPR_GRPC_PORT": "50004",
                "DAPR_CFG_APP_ID": "vmscfg",
                "PUBSUB_NAME": "pubsub",
                "POSTGRES_HOST": "localhost",
                "POSTGRES_PORT": "5433",
                "POSTGRES_USER": "postgres",
                "POSTGRES_PASSWORD": "postgres",
                "POSTGRES_FS_DB": "ta_fs",
                "VMS_STORAGE_BASE_PATH": "${workspaceFolder}/../media_storage"
            }
        },
        {
            "name": "VmsLogger (.NET)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "prepare:vmslogger",
            "postDebugTask": "dapr:vmslogger:stop",
            "program": "${workspaceFolder}/web_vms/VmsLogger/bin/Debug/net8.0/VmsLogger.dll",
            "cwd": "${workspaceFolder}/web_vms/VmsLogger",
            "stopAtEntry": false,
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "LOGGER_VMS_PORT": "5138",
                "DAPR_HTTP_PORT": "3510",
                "DAPR_GRPC_PORT": "50110",
                "VMS_STORAGE_BASE_PATH": "${workspaceFolder}/../media_storage"
            }
        },
        {
            "name": "Media Server (C++)",
            "type": "cppdbg",
            "request": "launch",
            "preLaunchTask": "prepare:vms",
            "postDebugTask": "dapr:vms:stop",
            "program": "${workspaceFolder}/media_server/build/vms",
            "args": [],
            "environment": [
                { "name": "DEBUGINFOD_URLS", "value": "" },
                {
                    "name": "VMS_STORAGE_BASE_PATH",
                    "value": "${workspaceFolder}/../media_storage"
                },
                {
                    "name": "GRPC_VMS_PORT",
                    "value": "50051"
                },
                {
                    "name": "APP_ID",
                    "value": "vms"
                },
                {
                    "name": "DAPR_GRPC_PORT",
                    "value": "50011"
                },
                {
                    "name": "DAPR_CFG_APP_ID",
                    "value": "vmscfg"
                },
                {
                    "name": "DAPR_ONVIF_APP_ID",
                    "value": "vmsonvif"
                },
                {
                    "name": "DAPR_FS_APP_ID",
                    "value": "vmsfs"
                },
                {
                    "name": "PUBSUB_NAME",
                    "value": "orderpubsub"
                },
                {
                    "name": "VMS_WEBRTC_RTSP_BASE_URL",
                    "value": "rtsp://localhost:8554"
                }
            ],
            "cwd": "${workspaceFolder}/media_server",
            "stopAtEntry": false,
            "MIMode": "gdb",
            "externalConsole": false,
            "setupCommands": [
                { "text": "-enable-pretty-printing" },
                { "text": "set debuginfod enabled off", "ignoreFailures": true },
                { "text": "set debuginfod urls \"\"", "ignoreFailures": true }, // Удаляет системные URL-адреса из GDB
                { "text": "set debuginfod verbose 0", "ignoreFailures": true }  // Полностью заглушает вывод этой подсистемы
            ]

        },
        {
            "name": "Frontend (Vite)",
            "type": "node",
            "request": "launch",
            "cwd": "${workspaceFolder}/web_vms/web_vms.client",
            "runtimeExecutable": "npm",
            "runtimeArgs": [
                "run",
                "dev"
            ],
            "console": "integratedTerminal",
            "skipFiles": [
                "<node_internals>/**"
            ]
        },
        {
            "name": "Frontend Debug (Chromium)",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:5173",
            "webRoot": "${workspaceFolder}/web_vms/web_vms.client/src"
        }
    ],
    "compounds": [
        {
            "name": "Full stack (F5)",
            "stopAll": true,
            "configurations": [
                "VmsCfg (.NET)",
                "VmsOnvif (.NET)",
                "VmsOnvifActors (.NET)",
                "VmsFs (.NET)",
                "VmsLogger (.NET)",
                "Media Server (C++)",
                "Backend (.NET)",
                "Frontend (Vite)",
                "Frontend Debug (Chromium)"
            ]
        }
    ]
}
