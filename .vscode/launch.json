{
    "version": "0.2.0",
    "configurations": [
    
        {
            "name": "Backend (.NET)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "prepare:web_vms",
            "postDebugTask": "dapr:web_vms:stop",
            "program": "${workspaceFolder}/web_vms/web_vms.Server/bin/Debug/net8.0/web_vms.Server.dll",
            "cwd": "${workspaceFolder}/web_vms/web_vms.Server",
            "stopAtEntry": false,
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "WEB_VMS_PORT": "5134",
                "DAPR_HTTP_PORT": "3500",
                "DAPR_GRPC_PORT": "50001",
                "DAPR_LOGGER_APP_ID": "vms",
                "DAPR_CFG_APP_ID": "vmscfg",
                "DAPR_FS_APP_ID": "vmsfs"
            }
        },
        {
            "name": "VmsCfg (.NET)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "prepare:vmscfg",
            "postDebugTask": "dapr:vmscfg:stop",
            "program": "${workspaceFolder}/web_vms/VmsCfg/bin/Debug/net8.0/VmsCfg.dll",
            "cwd": "${workspaceFolder}/web_vms/VmsCfg",
            "stopAtEntry": false,
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "CFG_VMS_PORT": "5135",
                "DAPR_HTTP_PORT": "3501",
                "DAPR_GRPC_PORT": "50002"
            }
        },
        {
            "name": "VmsOnvif (.NET)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "prepare:vmsonvif",
            "postDebugTask": "dapr:vmsonvif:stop",
            "program": "${workspaceFolder}/web_vms/VmsOnvif/bin/Debug/net8.0/VmsOnvif.dll",
            "cwd": "${workspaceFolder}/web_vms/VmsOnvif",
            "stopAtEntry": false,
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "ONVIF_SRV_PORT": "5136",
                "DAPR_HTTP_PORT": "3502",
                "DAPR_GRPC_PORT": "50003",
                "DAPR_CFG_APP_ID": "vmscfg"
            }
        },
        {
            "name": "VmsFs (.NET)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "prepare:vmsfs",
            "postDebugTask": "dapr:vmsfs:stop",
            "program": "${workspaceFolder}/web_vms/VmsFs/bin/Debug/net8.0/VmsFs.dll",
            "cwd": "${workspaceFolder}/web_vms/VmsFs",
            "stopAtEntry": false,
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "FS_VMS_PORT": "5137",
                "DAPR_HTTP_PORT": "3504",
                "DAPR_GRPC_PORT": "50004"
            }
        },
        {
            "name": "Media Server (C++)",
            "type": "cppdbg",
            "request": "launch",
            "preLaunchTask": "prepare:vms",
            "postDebugTask": "dapr:vms:stop",
            "program": "${workspaceFolder}/media_server/build/vms",
            "args": [],
            "environment": [
                {
                    "name": "VMS_STORAGE_BASE_PATH",
                    "value": "${workspaceFolder}/../media_storage"
                },
                {
                    "name": "GRPC_VMS_PORT",
                    "value": "50051"
                },
                {
                    "name": "DAPR_GRPC_ENDPOINT",
                    "value": "127.0.0.1:50011"
                },
                {
                    "name": "APP_ID",
                    "value": "vms"
                },
                {
                    "name": "DAPR_CFG_APP_ID",
                    "value": "vmscfg"
                },
                {
                    "name": "DAPR_ONVIF_APP_ID",
                    "value": "vmsonvif"
                },
                {
                    "name": "DAPR_FS_APP_ID",
                    "value": "vmsfs"
                }
            ],
            "cwd": "${workspaceFolder}/media_server",
            "stopAtEntry": false,
            "MIMode": "gdb",
            "externalConsole": false,
            "setupCommands": [
                {
                    "text": "-enable-pretty-printing"
                }
            ]
        },
        {
            "name": "Frontend (Vite)",
            "type": "node",
            "request": "launch",
            "cwd": "${workspaceFolder}/web_vms/web_vms.client",
            "runtimeExecutable": "npm",
            "runtimeArgs": [
                "run",
                "dev"
            ],
            "console": "integratedTerminal",
            "skipFiles": [
                "<node_internals>/**"
            ]
        },
        {
            "name": "Frontend Debug (Chromium)",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:5173",
            "webRoot": "${workspaceFolder}/web_vms/web_vms.client/src"
        }
    ],
    "compounds": [
        {
            "name": "Full stack (F5)",
            "stopAll": true,
            "configurations": [
                "VmsCfg (.NET)",
                "VmsOnvif (.NET)",
                "VmsFs (.NET)",
                "Media Server (C++)",
                "Backend (.NET)",
                "Frontend (Vite)",
                "Frontend Debug (Chromium)"
            ]
        },
        {
            "name": "Backend + services",
            "stopAll": true,
            "configurations": [
                "VmsCfg (.NET)",
                "VmsOnvif (.NET)",
                "VmsFs (.NET)",
                "Media Server (C++)",
                "Backend (.NET)"
            ]
        }
    ]
}
