{
    "version": "0.2.0",
    "configurations": [
    
        {
            "name": "Backend (.NET)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "prepare:web_vms",
            "postDebugTask": "dapr:web_vms:stop",
            "program": "${workspaceFolder}/web_vms/web_vms.Server/bin/Debug/net8.0/web_vms.Server.dll",
            "cwd": "${workspaceFolder}/web_vms/web_vms.Server",
            "stopAtEntry": false,
            "env": {
                "VMS_MEDIAMTX_READ_USER": "vms_read",
                "VMS_MEDIAMTX_READ_PASS": "dev_read_pass",
                "ASPNETCORE_ENVIRONMENT": "Development",
                "WEB_VMS_PORT": "5134",
                "DAPR_HTTP_PORT": "3600",
                "DAPR_GRPC_PORT": "51001",
                "DAPR_LOGGER_APP_ID": "vmslogger",
                "DAPR_CFG_APP_ID": "vmscfg",
                "DAPR_ONVIF_APP_ID": "vmsonvif",
                "DAPR_UTILS_APP_ID": "vmsutils",
                "DAPR_ANALYTICS_APP_ID": "vmsanalytics",
                "PUBSUB_NAME": "orderpubsub",
                "DAPR_STATE_STORE_NAME": "statestore",
                // Same value as in .env: it seals the WHEP session tokens, and a second gateway
                // instance can only close this one's sessions if both use the same key.
                "VMS_WHEP_SESSION_KEY": "8S4c0cfJ2TWKPRYaZ8OWyevkXfxYqedQq4/54QMcyyU=",
                "KEYCLOAK_URL": "http://localhost:8080",
                "KEYCLOAK_ADMIN_USER": "admin",
                "KEYCLOAK_ADMIN_PASSWORD": "admin",
                "KEYCLOAK_REALM_NAME": "myrealm",
                "KEYCLOAK_CLIENT_ID": "pubclient",
                "SQUARE_FRONTEND_ORIGIN": "http://localhost:8002",
                // The anonymous WHEP test player plays any camera without a login, so the backend
                // refuses to start with it enabled alongside KEYCLOAK_URL above. To use /test/live,
                // clear KEYCLOAK_URL in this configuration and set this back to "true".
                "VMS_EDGE_EXPORT_CHUNK_SECONDS": "60",
                "VMS_LIVE_TEST_PLAYER": ""
            }
        },
