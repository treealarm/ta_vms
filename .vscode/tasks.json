{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "dapr: sidecars up",
            "detail": "Every sidecar at once, from web_vms/dapr.yaml. The file declares no `command`, so the services themselves are started by the debugger. About 90 MB per sidecar.",
            "type": "shell",
            "command": "dapr",
            "args": [
                "run",
                "-f",
                "."
            ],
            "options": {
                "cwd": "${workspaceFolder}/web_vms"
            },
            "isBackground": true,
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "group": "dapr"
            },
            "problemMatcher": {
                "pattern": {
                    "regexp": "^(?:\\s*)$",
                    "file": 1,
                    "location": 1,
                    "message": 1
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "Starting Dapr with id",
                    "endsPattern": "(You're up and running|Initialized name resolution)"
                }
            }
        },
        {
            "label": "dapr: sidecars down",
            "detail": "Stops everything started by 'dapr: sidecars up'.",
            "type": "shell",
            "command": "dapr",
            "args": [
                "stop",
                "-f",
                "."
            ],
            "options": {
                "cwd": "${workspaceFolder}/web_vms"
            },
            "presentation": {
                "reveal": "silent",
                "panel": "dedicated"
            },
            "problemMatcher": []
        },
        {
            "label": "dapr:web_vms:start",
            "detail": "Just this one sidecar (~85 MB), for debugging a single service. Ports come from web_vms/dapr.yaml — keep them in step.",
            "type": "shell",
            "command": "dapr",
            "args": [
                "run",
                "--app-id",
                "web-vms",
                "--app-port",
                "5134",
                "--app-protocol",
                "http",
                "--dapr-http-port",
                "3600",
                "--dapr-grpc-port",
                "51001",
                "--metrics-port",
                "9190",
                "--dapr-internal-grpc-port",
                "19011",
                "--resources-path",
                "../init_files/dapr_components"
            ],
            "options": {
                "cwd": "${workspaceFolder}/web_vms"
            },
            "isBackground": true,
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "group": "dapr"
            },
            "problemMatcher": {
                "pattern": {
                    "regexp": "^(?:\\s*)$",
                    "file": 1,
                    "location": 1,
                    "message": 1
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "Starting Dapr with id",
                    "endsPattern": "(You're up and running|Initialized name resolution)"
                }
            }
        },
        {
            "label": "dapr:web_vms:stop",
            "detail": "Stops this sidecar. Also run before starting, so a sidecar left behind by an interrupted session does not hold the ports.",
            "type": "shell",
            "command": "dapr",
            "args": [
                "stop",
                "--app-id",
                "web-vms"
            ],
            "presentation": {
                "reveal": "silent",
                "panel": "dedicated"
            },
            "problemMatcher": []
        },
        {
            "label": "prepare:web_vms",
            "detail": "Clears any leftover sidecar for this app id, then starts a fresh one.",
