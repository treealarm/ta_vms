{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "dapr: sidecars up",
            "detail": "Every sidecar at once, from web_vms/dapr.yaml. The file declares no `command`, so the services themselves are started by the debugger. About 90 MB per sidecar.",
            "type": "shell",
            "command": "dapr",
            "args": [
                "run",
                "-f",
                "."
            ],
            "options": {
                "cwd": "${workspaceFolder}/web_vms"
            },
            "isBackground": true,
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "group": "dapr"
            },
            "problemMatcher": {
                "pattern": {
                    "regexp": "^(?:\\s*)$",
                    "file": 1,
                    "location": 1,
                    "message": 1
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "Starting Dapr with id",
                    "endsPattern": "(You're up and running|Initialized name resolution)"
                }
            }
        },
        {
            "label": "dapr: sidecars down",
            "detail": "Stops everything started by 'dapr: sidecars up'.",
            "type": "shell",
            "command": "dapr",
            "args": [
                "stop",
                "-f",
                "."
            ],
            "options": {
                "cwd": "${workspaceFolder}/web_vms"
            },
            "presentation": {
                "reveal": "silent",
                "panel": "dedicated"
            },
            "problemMatcher": []
        },
        {
            "label": "browser: free debug port",
            "detail": "Kills whatever still holds port 9222. Needed because the browser debug port is pinned (see the launch configuration), and a session that ends without closing its browser leaves one squatting — after a few of those every launch fails with 'Could not connect to debug target'.",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-Command",
                "Get-NetTCPConnection -State Listen -LocalPort 9222 -EA SilentlyContinue | ForEach-Object { Stop-Process -Id $_.OwningProcess -Force -EA SilentlyContinue }; exit 0"
            ],
            "presentation": {
                "reveal": "silent",
                "panel": "dedicated"
            },
            "problemMatcher": [],
            "linux": {
                "command": "bash",
                "args": [
                    "-lc",
                    "fuser -k 9222/tcp 2>/dev/null; true"
                ]
            },
            "osx": {
                "command": "bash",
                "args": [
                    "-lc",
                    "fuser -k 9222/tcp 2>/dev/null; true"
                ]
            }
        },
        {
            "label": "browser: prepare",
            "detail": "Frees the debug port, then waits until the stack actually serves.",
            "dependsOrder": "sequence",
            "dependsOn": [
                "browser: free debug port",
                "wait: stack ready"
            ],
            "problemMatcher": []
        },
        {
            "label": "wait: stack ready",
            "detail": "Waits until VmsCfg is actually serving, so the browser does not call the API while the stack is still starting. A Dapr sidecar's /v1.0/healthz answers 204 only once its app is up, and 500 while it is still waiting for it — which is exactly the readiness signal, and needs no script.",
            "type": "shell",
            "command": "curl",
            "args": [
                "--silent",
                "--show-error",
                "--fail",
                "--retry-all-errors",
                "--retry-connrefused",
                "--retry",
                "90",
                "--retry-delay",
                "1",
                "--max-time",
                "180",
                "--output",
                "NUL",
                "http://localhost:3601/v1.0/healthz"
            ],
            "presentation": {
                "reveal": "silent",
                "panel": "dedicated"
            },
            "problemMatcher": [],
            "linux": {
                "args": [
                    "--silent",
                    "--show-error",
                    "--fail",
                    "--retry-all-errors",
                    "--retry-connrefused",
                    "--retry",
                    "90",
                    "--retry-delay",
                    "1",
                    "--max-time",
                    "180",
                    "--output",
                    "/dev/null",
                    "http://localhost:3601/v1.0/healthz"
                ]
            },
            "osx": {
                "args": [
                    "--silent",
                    "--show-error",
                    "--fail",
                    "--retry-all-errors",
                    "--retry-connrefused",
                    "--retry",
                    "90",
                    "--retry-delay",
                    "1",
                    "--max-time",
                    "180",
                    "--output",
                    "/dev/null",
                    "http://localhost:3601/v1.0/healthz"
                ]
            }
        },
        {
            "label": "dapr:web_vms:start",
            "detail": "Just this one sidecar (~85 MB), for debugging a single service. Ports come from web_vms/dapr.yaml — keep them in step.",
