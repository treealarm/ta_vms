            "type": "shell",
            "command": "dapr",
            "args": [
                "stop",
                "--app-id",
                "vmssquaresingleton"
            ],
            "presentation": {
                "reveal": "silent",
                "panel": "dedicated"
            },
            "problemMatcher": []
        },
        {
            "label": "prepare:vmssquaresingleton",
            "detail": "Clears any leftover sidecar for this app id, then starts a fresh one.",
            "dependsOrder": "sequence",
            "dependsOn": [
                "dotnet:build",
                "dapr:vmssquaresingleton:stop",
                "dapr:vmssquaresingleton:start"
            ],
            "problemMatcher": []
        },
        {
            "label": "dapr:vms:start",
            "detail": "Just this one sidecar (~85 MB), for debugging a single service. Ports come from web_vms/dapr.yaml — keep them in step.",
            "type": "shell",
            "command": "dapr",
            "args": [
                "run",
                "--app-id",
                "vms",
                "--app-port",
                "50051",
                "--app-protocol",
                "grpc",
                "--dapr-http-port",
                "3607",
                "--dapr-grpc-port",
                "51008",
                "--metrics-port",
                "9197",
                "--dapr-internal-grpc-port",
                "19018",
                "--resources-path",
                "../init_files/dapr_components"
            ],
            "options": {
                "cwd": "${workspaceFolder}/web_vms"
            },
            "isBackground": true,
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "group": "dapr"
            },
            "problemMatcher": {
                "pattern": {
                    "regexp": "^(?:\\s*)$",
                    "file": 1,
                    "location": 1,
                    "message": 1
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "Starting Dapr with id",
                    "endsPattern": "(You're up and running|Initialized name resolution)"
                }
            }
        },
        {
            "label": "dapr:vms:stop",
            "detail": "Stops this sidecar. Also run before starting, so a sidecar left behind by an interrupted session does not hold the ports.",
            "type": "shell",
            "command": "dapr",
            "args": [
                "stop",
                "--app-id",
                "vms"
            ],
            "presentation": {
                "reveal": "silent",
                "panel": "dedicated"
            },
            "problemMatcher": []
        },
        {
            "label": "prepare:vms",
            "detail": "Builds vms, then clears any leftover sidecar for this app id and starts a fresh one.",
            "dependsOrder": "sequence",
            "dependsOn": [
                "cmake:configure:vms",
                "cmake:build:vms",
                "dapr:vms:stop",
                "dapr:vms:start"
            ],
            "problemMatcher": []
        },
        {
            "label": "dotnet:build",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/web_vms/web_vms.sln",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
            ],
            "options": {
                "cwd": "${workspaceFolder}/web_vms"
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "dotnet:publish",
            "command": "dotnet",
            "type": "process",
            "args": [
                "publish",
                "${workspaceFolder}/web_vms/web_vms.sln",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
            ],
            "options": {
                "cwd": "${workspaceFolder}/web_vms"
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "dotnet:watch",
            "command": "dotnet",
            "type": "process",
            "args": [
                "watch",
                "run",
                "--project",
                "${workspaceFolder}/web_vms/web_vms.sln"
            ],
            "options": {
                "cwd": "${workspaceFolder}/web_vms"
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "cmake:configure:vms",
            "detail": "Cheap to repeat: with the cache already present cmake re-runs in about a second.",
            "type": "process",
            "command": "cmake",
            "args": [
                "--preset",
                "linux-default"
            ],
            "windows": {
                "args": [
                    "--preset",
                    "windows-default",
                    // windows-default generates single-config Ninja, which takes the build type
                    // from the cache rather than from --build --config. Without this the build
                    // fails while parsing its own rules file.
                    "-DCMAKE_BUILD_TYPE=Debug"
                ]
            },
            "options": {
                "cwd": "${workspaceFolder}/media_server"
            },
            "problemMatcher": []
        },
        {
            "label": "cmake:build:vms",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/media_server/build",
                "--target",
                "vms"
            ],
            // Both, so compiler errors are clickable on either platform: the one that does not
            // match the current compiler's output simply finds nothing.
            "problemMatcher": [
                "$gcc",
                "$msCompile"
            ]
        },
        {
            "label": "build:all",
            "dependsOrder": "sequence",
            "dependsOn": [
                "dotnet:build",
                "cmake:configure:vms",
                "cmake:build:vms"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        }
    ]
