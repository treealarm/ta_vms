            "problemMatcher": {
                "pattern": {
                    "regexp": "^(?:\\s*)$",
                    "file": 1,
                    "location": 1,
                    "message": 1
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "Starting Dapr with id",
                    "endsPattern": "(You're up and running|Initialized name resolution)"
                }
            }
        },
        {
            "label": "dapr:web_vms:stop",
            "detail": "Stops this sidecar. Also run before starting, so a sidecar left behind by an interrupted session does not hold the ports.",
