# NOTE: docker-compose.yml puts every vms_rec service on the shared "common_app_network" (same
# network Square/multitenant_admin use) and has no Redis of its own — `docker compose up` alone
# now requires Square/multitenant_admin's stack (which provides that network + its "redis") to
# already be running. See docker-compose.yml's top comment and CLAUDE.md.

GRPC_VMS_PORT=50051
DAPR_GRPC_PORT=50001
WEB_VMS_PORT=5134

VMS_MTX_HOST="mediamtx"

VMS_STORAGE_BASE_PATH = /data/media_storage
VMS_LOG_PATH = /data/logs

DAPR_LOGGER_APP_ID="vmslogger"
DAPR_CFG_APP_ID="vmscfg"
DAPR_ONVIF_APP_ID="vmsonvif"
DAPR_UTILS_APP_ID="vmsutils"

MEDIA_SERVER_PAIRS=vms:vmsfs
DAPR_STATE_STORE_NAME=statestore

CFG_VMS_PORT=5135
FS_VMS_PORT=5137
LOGGER_VMS_PORT=5138
ONVIF_SRV_PORT=5136
ONVIF_ACTORS_PORT=5141
UTILS_VMS_PORT=5139
ANALYTICS_VMS_PORT=5140

PUBSUB_NAME=orderpubsub

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_CFG_DB=ta_cfg
POSTGRES_FS_DB=ta_fs
POSTGRES_ANALYTICS_DB=ta_analytics

ANALYTICS_DEBOUNCE_SECONDS=10
ANALYTICS_RETAIN_TIMEOUT_SECONDS=30
# Optional: Dapr app-id of the video_a analytics-worker sidecar (e.g. "analytics-worker").
# Leave empty to run without video_a — analytics ingestion is simply inactive (NoOpAnalyticsWorkerClient).
DAPR_ANALYTICS_WORKER_APP_ID=

ASPNETCORE_ENVIRONMENT=Development

# Optional: shared Keycloak login (Square's realm). Leave KEYCLOAK_URL empty to run web_vms
# without auth. web_vms reaches keycloakservice via the shared common_app_network (see
# docker-compose.yml — all vms_rec services now live on that network, shared with
# Square/multitenant_admin).
KEYCLOAK_URL=
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_REALM_NAME=myrealm
KEYCLOAK_CLIENT_ID=pubclient

# Optional, dev-only: enables the unauthenticated /test/live page + api/live/whep-test/*
# endpoints for testing the MediaMTX WHEP proxy in isolation, without logging in. Leave unset
# (or anything other than "true") to disable — must be unset in production.
VMS_LIVE_TEST_PLAYER=true

# Optional: push vms_rec's cameras/properties/alarms into Square's map (see
# docs/square-integration-plan.md). Leave empty to disable the push. When set, must be Square's
# integrationhost Dapr app-id (not leafletalarms) — reachable via the shared common_app_network.
SQUARE_INTEGRATION_SINK_APP_ID=
SQUARE_INTEGRATION_DEFAULT_LAT=0
SQUARE_INTEGRATION_DEFAULT_LON=0
# Optional: origin of Square's frontend (e.g. http://localhost:8002) — enables CORS on web_vms
# so Square's Monitor tab can call vms_rec's archive/recording-ranges API directly. Leave empty to
# disable CORS entirely (standalone behavior unchanged).
SQUARE_FRONTEND_ORIGIN=

#app - поднять все , если пусто - только инфраструктуру
COMPOSE_PROFILES=
