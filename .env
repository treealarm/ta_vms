# NOTE: docker-compose.yml puts every ta_vms service on the shared "common_app_network" (same
# network Square/multitenant_admin use) and has no Redis of its own — `docker compose up` alone
# now requires Square/multitenant_admin's stack (which provides that network + its "redis") to
# already be running. See docker-compose.yml's top comment and CLAUDE.md.

GRPC_VMS_PORT=50051
DAPR_GRPC_PORT=50001
WEB_VMS_PORT=5134

VMS_MTX_HOST="mediamtx"

# MediaMTX service accounts (init_files/config/mediamtx.yml has the matching users; the passwords
# reach MediaMTX as MTX_AUTHINTERNALUSERS_<i>_PASS, see docker-compose.yml). MediaMTX has no
# anonymous access, so these are required by every service that talks to it:
#   publish — video_srv, pushing camera streams over RTSP
#   read    — the web_vms WHEP gateway, VmsAnalyticsSingleton's RTSP pull, VmsUtils' Control API calls
# Browsers never see these: they authenticate to web_vms with their own JWT and the gateway
# substitutes the read account on its way to MediaMTX.
VMS_MEDIAMTX_PUBLISH_USER=vms_publish
VMS_MEDIAMTX_PUBLISH_PASS=dev_publish_pass
VMS_MEDIAMTX_READ_USER=vms_read
VMS_MEDIAMTX_READ_PASS=dev_read_pass

# Seals the opaque WHEP session tokens web_vms hands to browsers (base64 of 32 random bytes,
# `openssl rand -base64 32`). Every web_vms replica must use the same value — the token is what a
# replica reads to learn which MediaMTX session to close, so a per-replica key would break teardown
# for every request that does not land back on the instance that started the session.
VMS_WHEP_SESSION_KEY=8S4c0cfJ2TWKPRYaZ8OWyevkXfxYqedQq4/54QMcyyU=

VMS_STORAGE_BASE_PATH = /data/media_storage
# Camera-side (edge) archive imports exported as downloadable mp4 files. Deliberately outside the
# storage roots: these are not archive clips and must not appear on the recording timeline.
VMS_EXPORT_BASE_PATH = /data/exports
# How long an export stays downloadable before EdgeExportCleaner removes it.
VMS_EDGE_EXPORT_TTL_HOURS = 24
# One exported mp4 per this many seconds: a single multi-gigabyte file is awkward to download and
# cannot be previewed without pulling all of it.
VMS_EDGE_EXPORT_CHUNK_SECONDS = 60
VMS_LOG_PATH = /data/logs

# video_srv: which encoder backend transcodes live video that a camera publishes in something
# other than H.264 (HEVC, in practice) for WebRTC viewing. One encode per viewed stream, running
# continuously, so this is the largest sustained CPU cost in the service.
#
# Optional. Unset means VA-API, the one hardware encoder the `vaapi` feature in ta-deps' ffmpeg
# builds -- and nothing else: this variable selects the *hardware* path only. Whenever hardware
# cannot be reached, or the chain settles on a software encoder, the stream goes back to the CPU
# transcoder, which asks libx264 for tune=zerolatency and so does not carry the ~1.4s of pipeline
# delay the library's own software backend does. Hardware needs /dev/dri passed into the
# container -- see docker-compose.gpu.yml.example.
#
# Accepted values are the encoder library's own backend names -- `vaapi` pins the hardware one,
# `x264` (or any other software name) means "never use hardware here", `auto` walks the
# library's full order including backends this ffmpeg build does not carry. Anything else fails the service at startup, with the
# accepted spellings in the message, rather than quietly selecting a different encoder.
# VMS_VIDEO_ENCODER = vaapi

# Source liveness — how the archive learns it had a hole. video_srv heartbeats every stream it
# reads; VmsFs turns silence into rows of source_outages. Interval boundaries come from the last
# frame timestamp, so the period below sets only how fast an outage is noticed, not how precisely
# it is recorded.
VMS_SOURCE_LIVENESS_PERIOD_SECONDS = 15
# video_srv: how often observed stream parameters (resolution, codec, fps, bitrate) are written
# to the state store, where the camera catalogue picks them up for the monitor's adaptive live
# quality. A change in the encoder's output is published within a second regardless; this only sets
# how often unchanged values are rewritten to refresh their TTL, which is three periods.
VMS_STREAM_STATS_PERIOD_SECONDS = 15
# VmsFs: no heartbeat for longer than this means the source is gone (camera or the media server).
VMS_SOURCE_LIVENESS_STALE_SECONDS = 60
# Debug "Entity State" feed: video_srv publishes one message per stream every this many seconds,
# and event-driven publishers (VmsAnalyticsSingleton) report at all. Unset or 0 turns the feed off entirely —
# its volume is streams divided by this period, on the bus shared with Square, so a large
# installation should raise it or leave it off rather than pay for a debugging aid.
VMS_DEBUG_ENTITY_STATE_SECONDS = 10
# VmsFs: an outage shorter than this is a blink and never reaches the table. Also collapses a
# flapping camera into one row instead of thousands.
VMS_SOURCE_OUTAGE_GRACE_SECONDS = 15
# VmsFs: closed outage rows are removed after this many days. Open ones are kept regardless of age.
VMS_OUTAGE_RETENTION_DAYS = 90
# Automatic recovery of archive gaps from the camera's own storage. Enabled per stream in the camera
# settings, never globally: a replay pull takes one of the camera's few RTSP sessions.
# A camera does not offer a just-recorded stretch for replay immediately, so a gap is left to settle
# before the first attempt — asking too early returns nothing and burns an attempt.
VMS_BACKFILL_SETTLE_SECONDS = 60
# Minimum spacing between attempts on the same gap.
VMS_BACKFILL_RETRY_SECONDS = 300
# Nothing older than this is attempted; the card holds about an hour, so this is already generous.
VMS_BACKFILL_LOOKBACK_HOURS = 48
# Finished import jobs are operational history and age out quickly; queued and running ones are
# never removed by age — an interrupted job returns to the queue through its expired lease.
VMS_BACKFILL_JOB_RETENTION_HOURS = 24

# roitrc. GRPC_ROI_BIND is separate from the port because the service
# listens on loopback by default and has to be told to accept the sidecar.
GRPC_ROI_BIND = 0.0.0.0
GRPC_ROI_PORT = 5142
# Absolute directories gRPC paths must sit under. Everything the service is
# allowed to read or write lives under the shared data volume.
ROI_ALLOWED_ROOTS = /data

# Re-compressing archive clips with ROI. Off unless a camera asks for it.
# How long a clip must be closed before it is touched: long enough that nothing
# is still finishing with it.
# Spacing between attempts on the same clip; doubles with each failure.
VMS_ROI_RETRY_SECONDS = 600
VMS_ROI_MAX_ATTEMPTS = 3
# Quality. crf is the base quantizer; the background delta is relative to it,
# positive meaning coarser. What each detected object gets is not set here: the
# encoder library's importance model weighs it by class inside the module.
VMS_ROI_CRF = 28
VMS_ROI_BACKGROUND_QP_DELTA = 8
# How long a box keeps applying after its sample. Also the window coverage is
# measured over, so the two cannot disagree. Keep it at least half the interval
# between samples (ANALYTICS_METADATA_MAX_SAMPLE_HZ), or gaps open up between
# them — in the measurement and in what actually gets protected.
VMS_ROI_HOLD_SEC = 0.5

DAPR_LOGGER_APP_ID="vmslogger"
DAPR_CFG_APP_ID="vmscfg"
DAPR_ONVIF_APP_ID="vmsonvif"
DAPR_UTILS_APP_ID="vmsutils"
# The one service that must never be replicated: it holds work that has to happen exactly
# once and in-memory aggregation a second instance would split rather than share.
DAPR_SINGLETON_APP_ID="vmssingleton"
# The link to Square. Also a singleton: its startup resync pushes the whole camera tree.
DAPR_SQUARE_SINGLETON_APP_ID="vmssquaresingleton"
DAPR_ANALYTICS_APP_ID="vmsanalyticssingleton"
# Keeps a PTZ camera pointed at an object the analytics found. A singleton because one camera
# must have exactly one control loop: two would send the motor opposing commands.
DAPR_PTZ_TRACKING_APP_ID="vmsptztrackingsingleton"
# One entry per node: media server, the VmsFs that owns its archive volume, the VmsOnvif that shares
# its camera subnet, the VmsLogger that can read its log files, and — optionally, as a fifth part —
# the roitrc that can reach the same disk. They sit on the same machine: ONVIF reaches a
# camera over the same local network RTSP does, logs are files on local disk, and the ROI service is
# handed absolute paths to clips. A central instance can reach none of the three, and for ROI it is
# worse than unreachable — another node may hold a different file at the same path and lose it.
#
# Leave the fifth part off on a node that should not re-compress; the other four are required.
MEDIA_SERVER_PAIRS=vms:vmsfs:vmsonvif:vmslogger:roitrc
DAPR_STATE_STORE_NAME=statestore

CFG_VMS_PORT=5135
FS_VMS_PORT=5137
LOGGER_VMS_PORT=5138
ONVIF_SRV_PORT=5136
ONVIF_ACTORS_PORT=5141
UTILS_VMS_PORT=5139
SINGLETON_VMS_PORT=5145
SQUARE_SINGLETON_VMS_PORT=5147
ANALYTICS_VMS_PORT=5140
PTZ_TRACKING_VMS_PORT=5148

PUBSUB_NAME=orderpubsub
# Broker behind that component. The credentials are duplicated in
# init_files/dapr_components/orderpubsub.yaml (and its docker/ twin) because Dapr does not expand
# environment variables in component metadata — db-init compares the two and fails if they drift.
# The built-in "guest" account is deliberately not used: RabbitMQ only lets it connect from
# localhost, so from another container it is rejected outright.
RABBITMQ_DEFAULT_USER=vms
RABBITMQ_DEFAULT_PASS=vms
# Host-side ports. Not 5672/15672: this machine already runs another RabbitMQ on 5672/5673 (and
# its UI on 15672/15673). Services debugged on the host reach the broker through this port, so it
# is also written into init_files/dapr_components/orderpubsub.yaml — change both together.
RABBITMQ_PORT=5674
RABBITMQ_MANAGEMENT_PORT=15674

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_CFG_DB=ta_cfg
POSTGRES_FS_DB=ta_fs
POSTGRES_ANALYTICS_DB=ta_analytics
# Backs the Dapr state store component. Not read by any service directly — the connection
# string lives in init_files/dapr_components/statestore.yaml — but scripts/prepare-databases.sh
# creates every POSTGRES_*_DB it finds, so naming it here is what gets the database made.
POSTGRES_STATE_DB=ta_state

ANALYTICS_DEBOUNCE_SECONDS=10
# Re-identification (in-memory): min cosine similarity [0..1] to treat a body embedding as the same
# object, how long a sighting stays in the match gallery, and the gap after which the same object
# starts a new event_id group (episodes within the gap group together in the Events tree).
ANALYTICS_REID_MATCH_MIN_SCORE=0.6
ANALYTICS_REID_GALLERY_WINDOW_SECONDS=900
ANALYTICS_EVENT_GROUP_GAP_SECONDS=300
# Samples per second of analytics geometry kept per (camera, stream, source) when recording it into
# the archive for the archive-player overlay. Decimation matters: an ONVIF camera narrates at frame
# rate, and every kept sample becomes a row that lives as long as its clip. 0 turns archiving of
# geometry off entirely (the live overlay is unaffected).
ANALYTICS_METADATA_MAX_SAMPLE_HZ=5
# Optional: comma-separated Dapr app-ids of video_a analytics-worker sidecars (e.g.
# "analytics-worker" or "analytics-worker,analytics-worker-2"). Watches are sharded across
# them by rendezvous hash. Leave empty to run without video_a — analytics is simply inactive.
DAPR_ANALYTICS_WORKER_APP_IDS=

ASPNETCORE_ENVIRONMENT=Development

# Optional: shared Keycloak login (Square's realm). Leave KEYCLOAK_URL empty to run web_vms
# without auth. web_vms reaches keycloakservice via the shared common_app_network (see
# docker-compose.yml — all ta_vms services now live on that network, shared with
# Square/multitenant_admin).
KEYCLOAK_URL=
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_REALM_NAME=myrealm
KEYCLOAK_CLIENT_ID=pubclient

# Optional, dev-only: enables the unauthenticated /test/live page + api/live/whep-test/*
# endpoints for testing the MediaMTX WHEP proxy in isolation, without logging in. It can play any
# camera by id with no credentials, so web_vms refuses to start when this is "true" while
# KEYCLOAK_URL is set. Leave unset (or anything other than "true") to disable.
VMS_LIVE_TEST_PLAYER=

# Optional: where maps on the Maps tab get their background tiles. A URL template with {z},
# {x}, {y} (and optionally {s}). Only web_vms.Server reads it: browsers go through its caching
# proxy (/api/map/tiles), which keeps each tile in the state store for 30 days and identifies
# itself to the provider. Empty means maps are drawn over a plain grid -- plans never use tiles,
# except while an administrator aligns one in real coordinates. The public OpenStreetMap servers
# are fine for development and small sites (https://operations.osmfoundation.org/policies/tiles/);
# a larger deployment should use its own tile server or a commercial provider.
VMS_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Credit line shown under the map. Most providers require one; OpenStreetMap does.
VMS_MAP_TILE_ATTRIBUTION=© OpenStreetMap contributors

# Optional: push ta_vms's cameras/properties/alarms into Square's map (see
# docs/square-integration-plan.md). Leave empty to disable the push. When set, must be Square's
# integrationhost Dapr app-id (not leafletalarms) — reachable via the shared common_app_network.
SQUARE_INTEGRATION_SINK_APP_ID=
# Who ta_vms is in Square's object tree — the root its cameras hang under. Configured, not
# derived from a process name, so moving the integration between services does not re-parent
# the tree and two ta_vms deployments can share one Square. Square is configured with the same
# value; the object id is derived from it deterministically, so nothing is exchanged at runtime.
# TREAT AS PERMANENT: changing it orphans everything already registered under the old root.
SQUARE_INTEGRATION_PRODUCER_ID=vmscfg
SQUARE_INTEGRATION_DEFAULT_LAT=0
SQUARE_INTEGRATION_DEFAULT_LON=0
# Optional: origin of Square's frontend (e.g. http://localhost:8002) — enables CORS on web_vms
# so Square's Monitor tab can call ta_vms's archive/recording-ranges API directly. Leave empty to
# disable CORS entirely (standalone behavior unchanged).
SQUARE_FRONTEND_ORIGIN=

#app - bring everything up; empty - only the infrastructure
COMPOSE_PROFILES=
