roitrc/sve/build/
roitrc/sve/build-int/
roitrc/sve/build-software/
# Unpacked Intel media runtime from an approach that was dropped: untracked, and
# the runtime image installs the driver from apt instead.
roitrc/sve/runtime/
# Synthetic scenes and check.sh run output: hundreds of megabytes that the image
# has no use for and that every docker build would otherwise ship as context.
roitrc/sve/testdata/

