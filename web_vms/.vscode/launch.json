{
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Backend (.NET)",
        "type": "coreclr",
        "request": "launch",
        "preLaunchTask": "build",
        "program": "${workspaceFolder}/web_vms.Server/bin/Debug/net8.0/web_vms.Server.dll",
        "cwd": "${workspaceFolder}/web_vms.Server",
        "stopAtEntry": false,
        "env": {
          "ASPNETCORE_ENVIRONMENT": "Development"
        }
      },
      {
        "name": "VmsCfg (.NET)",
        "type": "coreclr",
        "request": "launch",
        "preLaunchTask": "build",
        "program": "${workspaceFolder}/VmsCfg/bin/Debug/net8.0/VmsCfg.dll",
        "cwd": "${workspaceFolder}/VmsCfg",
        "stopAtEntry": false,
        "env": {
          "ASPNETCORE_ENVIRONMENT": "Development",
          "CFG_VMS_PORT": "5135"
        }
      },
      {
        "name": "Frontend (Vite)",
        "type": "node",
        "request": "launch",
        "cwd": "${workspaceFolder}/web_vms.client",
        "runtimeExecutable": "npm",
        "runtimeArgs": ["run", "dev"],
        "console": "integratedTerminal",
        "skipFiles": ["<node_internals>/**"]
      },
      {
        "name": "Frontend Debug (Chromium)",
        "type": "chrome",
        "request": "launch",
        "url": "http://localhost:5173",
        "webRoot": "${workspaceFolder}/web_vms.client/src"
      }
    ],
    "compounds": [
      {
        "name": "Full stack (F5)",
        "stopAll": true,
        "configurations": [
          "VmsCfg (.NET)",
          "Backend (.NET)",
          "Frontend (Vite)",
          "Frontend Debug (Chromium)"
        ]
      }
    ]
  }