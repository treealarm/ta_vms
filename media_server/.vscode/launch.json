{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug CMake Target",
            "type": "cppdbg",
            "request": "launch",
            "preLaunchTask": "prepare:vms",
            "postDebugTask": "dapr:vms:stop",
            "program": "${command:cmake.launchTargetPath}",
            "args": [],
            "environment": [
                {
                    "name": "VMS_STORAGE_BASE_PATH",
                    "value": "${workspaceFolder}/../../media_storage"
                },
                {
                    "name": "GRPC_VMS_PORT",
                    "value": "50051"
                },
                {
                    "name": "DAPR_GRPC_ENDPOINT",
                    "value": "127.0.0.1:50011"
                },
                {
                    "name": "DAPR_VMS_APP_ID",
                    "value": "vms"
                },
                {
                    "name": "DAPR_CFG_APP_ID",
                    "value": "vmscfg"
                },
                {
                    "name": "DAPR_ONVIF_APP_ID",
                    "value": "vmsonvif"
                }
            ],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "MIMode": "gdb",
            "externalConsole": false,
            "setupCommands": [
                {
                    "text": "-enable-pretty-printing"
                }
            ]
        }
    ]
}
