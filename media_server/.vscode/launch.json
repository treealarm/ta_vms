{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug CMake Target",
            "type": "cppdbg",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "args": [],
            "environment": [
                {
                    "name": "VMS_STORAGE_BASE_PATH",
                    "value": "${workspaceFolder}/../../media_storage"
                }
            ],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "MIMode": "gdb",
            "externalConsole": false,
            "setupCommands": [
                {
                    "text": "-enable-pretty-printing"
                }
            ]
        }
    ]
}